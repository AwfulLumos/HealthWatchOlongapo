generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String?        @unique
  password      String
  role          user_role
  accountStatus record_status? @default(Active)
  lastLogin     DateTime?      @db.Timestamp(6)
  staffId       String?        @unique
  createdAt     DateTime?      @default(now()) @db.Timestamp(6)
  updatedAt     DateTime       @updatedAt @db.Timestamp(6)
  refreshTokens RefreshToken[]
  staff         Staff?         @relation(fields: [staffId], references: [id], onUpdate: NoAction)

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime  @db.Timestamp(6)
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("refresh_tokens")
}

model Station {
  id        String    @id @default(cuid())
  name      String    @unique
  address   String?
  contact   String?
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @db.Timestamp(6)
  staff     Staff[]

  @@map("stations")
}

model Staff {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  role          staff_role
  licenseNumber String?
  contact       String
  email         String         @unique
  accountStatus record_status? @default(Active)
  stationId     String?
  createdAt     DateTime?      @default(now()) @db.Timestamp(6)
  updatedAt     DateTime       @updatedAt @db.Timestamp(6)
  appointments  Appointment[]
  consultations Consultation[]
  prescriptions Prescription[]
  station       Station?       @relation(fields: [stationId], references: [id], onUpdate: NoAction)
  user          User?

  @@map("staff")
}

model Barangay {
  id        String    @id @default(cuid())
  name      String    @unique
  zipCode   String?
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @db.Timestamp(6)
  patients  Patient[]

  @@map("barangays")
}

model Patient {
  id                     String             @id @default(cuid())
  firstName              String
  lastName               String
  dob                    DateTime           @db.Timestamp(6)
  gender                 gender_type
  bloodType              String?
  civilStatus            civil_status_type?
  contact                String
  address                String
  emergencyContact       String
  emergencyContactNumber String
  philhealth             String?
  status                 record_status?     @default(Active)
  barangayId             String?
  createdAt              DateTime?          @default(now()) @db.Timestamp(6)
  updatedAt              DateTime           @updatedAt @db.Timestamp(6)
  appointments           Appointment[]
  consultations          Consultation[]
  medicalHistory         MedicalCondition[]
  barangay               Barangay?          @relation(fields: [barangayId], references: [id], onUpdate: NoAction)
  prescriptions          Prescription[]
  vitalSigns             VitalSigns[]

  @@map("patients")
}

model MedicalCondition {
  id            String            @id @default(cuid())
  condition     String
  status        condition_status? @default(Active)
  notes         String?
  diagnosedDate DateTime?         @db.Timestamp(6)
  patientId     String
  createdAt     DateTime?         @default(now()) @db.Timestamp(6)
  updatedAt     DateTime          @updatedAt @db.Timestamp(6)
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("medical_conditions")
}

model Appointment {
  id            String              @id @default(cuid())
  scheduledDate DateTime            @db.Timestamp(6)
  purpose       String
  status        appointment_status? @default(Pending)
  notes         String?
  patientId     String
  staffId       String
  createdAt     DateTime?           @default(now()) @db.Timestamp(6)
  updatedAt     DateTime            @updatedAt @db.Timestamp(6)
  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff         Staff               @relation(fields: [staffId], references: [id], onUpdate: NoAction)

  @@map("appointments")
}

model Consultation {
  id             String               @id @default(cuid())
  date           DateTime?            @default(now()) @db.Timestamp(6)
  chiefComplaint String
  symptoms       String
  diagnosis      String
  icdCode        String?
  type           consultation_type?   @default(Regular)
  status         consultation_status? @default(InProgress)
  notes          String?
  patientId      String
  staffId        String
  createdAt      DateTime?            @default(now()) @db.Timestamp(6)
  updatedAt      DateTime             @updatedAt @db.Timestamp(6)
  patient        Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff          Staff                @relation(fields: [staffId], references: [id], onUpdate: NoAction)
  prescriptions  Prescription[]
  vitalSigns     VitalSigns[]

  @@map("consultations")
}

model Prescription {
  id           String       @id @default(cuid())
  date         DateTime?    @default(now()) @db.Timestamp(6)
  medicine     String
  dosage       String
  frequency    String
  duration     String
  instructions String?
  consultId    String
  patientId    String
  doctorId     String
  createdAt    DateTime?    @default(now()) @db.Timestamp(6)
  updatedAt    DateTime     @updatedAt @db.Timestamp(6)
  consultation Consultation @relation(fields: [consultId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  doctor       Staff        @relation(fields: [doctorId], references: [id], onUpdate: NoAction)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("prescriptions")
}

model VitalSigns {
  id           String        @id @default(cuid())
  date         DateTime?     @default(now()) @db.Timestamp(6)
  bpSystolic   Int
  bpDiastolic  Int
  pulseRate    Int
  respRate     Int
  temperature  Decimal       @db.Decimal(4, 1)
  bloodSugar   Decimal?      @db.Decimal(5, 1)
  weight       Decimal       @db.Decimal(5, 2)
  height       Decimal       @db.Decimal(5, 2)
  bmi          Decimal       @db.Decimal(4, 1)
  consultId    String?
  patientId    String
  createdAt    DateTime?     @default(now()) @db.Timestamp(6)
  updatedAt    DateTime      @updatedAt @db.Timestamp(6)
  consultation Consultation? @relation(fields: [consultId], references: [id], onUpdate: NoAction)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("vital_signs")
}

model AuditLog {
  id         String    @id @default(cuid())
  action     String
  entityType String
  entityId   String
  userId     String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime? @default(now()) @db.Timestamp(6)

  @@map("audit_logs")
}

enum appointment_status {
  Pending
  Confirmed
  Cancelled
  Completed
}

enum civil_status_type {
  Single
  Married
  Widowed
  Divorced
  Separated
}

enum condition_status {
  Active
  Resolved
}

enum consultation_status {
  InProgress
  Completed
  Referred
}

enum consultation_type {
  Regular
  FollowUp
  Emergency
}

enum gender_type {
  Male
  Female
}

enum record_status {
  Active
  Inactive
}

enum staff_role {
  Doctor
  Nurse
  Midwife
  BHW
}

enum user_role {
  Admin
  Employee
}
